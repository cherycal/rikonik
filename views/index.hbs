  <a class="navbar-brand" href="/">DB: {{dbname}}.</a>

  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="navbarSupportedContent">

    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

      <li class="nav-item">
        <a class="nav-link active" aria-current="page" href="/">Home</a>
      </li>

      <li class="nav-item">
        <a class="nav-link" href="#">Link</a>
      </li>

      <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
          aria-expanded="false">
          Tables
        </a>
        <ul class="dropdown-menu"
          style="background-color: rgb(44, 44, 35); color: grey; max-height: 60vh; overflow:auto;">
          <li><a class="dropdown-item" style="background-color: rgb(44, 44, 35); color: grey;"
              href="/showTables">List all tables</a></li>
          <div class="dropdown-divider"></div>

          {{#each tableList}}
          <li><a class="dropdown-item" style="background-color: rgb(44, 44, 35); color: grey;"
              href="/queryTable/{{Tables_in_DB}}">{{Tables_in_DB}}</a></li>
          <div class="dropdown-divider"></div>
          {{/each}}
        </ul>
      </li>

      <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown"
          aria-expanded="false">
          Schema
        </a>

        <ul class="dropdown-menu"
          style="background-color: rgb(44, 44, 35); color: grey; max-height: 60vh; overflow:auto;">

          <li>
            <a class="dropdown-item" style="background-color: rgb(44, 44, 35); color: grey;"
              href="/dbselect/public">
              public
            </a>
          </li>

        </ul>
      </li>

    </ul>

    <!-- QUERY FORM -->
    <form class="d-flex flex-wrap gap-2" id="queryForm" method="POST" action="/" novalidate>

      <!-- SELECT -->
      <textarea class="form-control" style="background-color: black; font-size:small; width: 200px; color: white;"
        name="columns" placeholder="select">{{cols}}</textarea>

      <!-- FROM -->
      <input class="form-control" style="background-color: black; font-size:small; width: 200px; color: white;"
        type="text" name="table_name" placeholder="from" value="{{table}}" />

      <!-- WHERE -->
      <textarea class="form-control"
        style="background-color: black; font-size:small; height: 70px; width: 480px; color: white;"
        name="where_term" placeholder="where">{{whereTerm}}</textarea>

      <!-- ORDER BY -->
      <textarea class="form-control" style="background-color: black; font-size:small; width: 200px; color: white;"
        name="order_term" placeholder="order by">{{orderTerm}}</textarea>

      <button class="btn btn-outline-light" type="submit">Search</button>
    </form>

    <!-- ENTER / SHIFT+ENTER BEHAVIOR -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("queryForm");

        form.addEventListener("keydown", function (e) {
          if (e.key === "Enter") {
            if (e.shiftKey) return; // newline
            e.preventDefault();
            form.submit();
          }
        });
      });
    </script>

  </div>
</div>